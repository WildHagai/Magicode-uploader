{
  "name": "magicode-uploader",
  "version": "1.4.0",
  "private": true,
  "description": "Development scripts and end-to-end tests for Magicode Uploader (the app itself is C#, see src/MagicodeUploader)",
  "type": "module",
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "build": "dotnet build src/MagicodeUploader -c Release --nologo",
    "build:dll": "scripts\\build-dll.bat",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "dotnet test test/MagicodeUploader.Tests -c Release --nologo",
    "test:e2e": "npm run build && node --test --test-concurrency=1 \"test/*.test.js\" \"test/e2e/*.test.js\"",
    "test:live": "npm run build && node --test \"test/e2e/live.e2e.test.js\"",
    "test:shell": "node --test --test-concurrency=1 \"test/e2e/shell.e2e.test.js\"",
    "install:app": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "uninstall:app": "powershell -ExecutionPolicy Bypass -File scripts/uninstall.ps1"
  }
}
