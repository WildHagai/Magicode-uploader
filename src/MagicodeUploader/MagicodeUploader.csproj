<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 is part of Windows 10 (1903+) and Windows 11, so the
       uploader runs without installing any runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MagicodeUploader</AssemblyName>
    <RootNamespace>MagicodeUploader</RootNamespace>
    <Version>1.4.0</Version>
    <!-- Product version is just the version, without "+<commit>", so it is the same in every build of a release. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Magicode Uploader</Product>
    <Company>Magicode Uploader contributors</Company>
    <Copyright>Magicode Uploader contributors</Copyright>
    <Description>Upload files to send.magicode.me from the Explorer context menu</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Always bin\Release\net48, even with Platform=x64 set by a C++ build environment;
         the installer and the tests expect it there. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationIcon Condition="Exists('..\..\Assets\app.ico')">..\..\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MagicodeUploader.Tests" />
  </ItemGroup>

</Project>
