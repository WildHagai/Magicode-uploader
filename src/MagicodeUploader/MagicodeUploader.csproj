<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 is part of Windows 10 (1903+) and Windows 11, so the
       uploader runs without installing any runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MagicodeUploader</AssemblyName>
    <RootNamespace>MagicodeUploader</RootNamespace>
    <Version>1.3.0</Version>
    <Product>Magicode Uploader</Product>
    <Description>Upload files to send.magicode.me from the Explorer context menu</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationIcon Condition="Exists('..\..\Assets\app.ico')">..\..\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MagicodeUploader.Tests" />
  </ItemGroup>

</Project>
